#ifndef SABERCAT_COLOR_SPACE_SLANGH
#define SABERCAT_COLOR_SPACE_SLANGH

// The exact sRGB transfer functions (IEC 61966-2-1), piecewise. Mirrored on
// the host by sabercat's test helpers (examples/common/color_space.h).
//
// Color is display-referred (sRGB-encoded) where a Gaussian's color
// enters -- the SH DC color and the forward color -- and linear where it
// is lit. The lighting kernels decode the first and encode their Lit output.

float srgbToLinear(float c)
{
    return c <= 0.04045f ? c / 12.92f : pow((c + 0.055f) / 1.055f, 2.4f);
}

float linearToSrgb(float l)
{
    return l <= 0.0031308f ? 12.92f * l : 1.055f * pow(l, 1.0f / 2.4f) - 0.055f;
}

float3 srgbToLinear(float3 c)
{
    return float3(srgbToLinear(c.x), srgbToLinear(c.y), srgbToLinear(c.z));
}

float3 linearToSrgb(float3 l)
{
    return float3(linearToSrgb(l.x), linearToSrgb(l.y), linearToSrgb(l.z));
}

#endif

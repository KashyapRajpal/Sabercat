// Template for each app's Windows resource script. CMake (sabercat_add_app_resources
// in apps/CMakeLists.txt) fills in the @...@ values and compiles the result into
// the executable: the Sabercat icon, which Explorer shows as the first icon
// resource, and the version information.

#include <windows.h>
#include "@SABERCAT_RESOURCE_HEADER@"

IDI_SABERCAT ICON "@SABERCAT_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SABERCAT_RC_VERSION@
 PRODUCTVERSION @SABERCAT_RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@SABERCAT_APP_DESCRIPTION@"
            VALUE "FileVersion", "@SABERCAT_VERSION_STRING@"
            VALUE "InternalName", "@SABERCAT_APP_NAME@"
            VALUE "LegalCopyright", "Copyright 2026 Kashyap Rajpal"
            VALUE "OriginalFilename", "@SABERCAT_APP_NAME@.exe"
            VALUE "ProductName", "Sabercat"
            VALUE "ProductVersion", "@SABERCAT_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

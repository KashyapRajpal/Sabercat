# ── Build output ────────────────────────────────────────────────
build/
# Visual Studio "Open Folder" CMake output
out/
# Extra build trees (build-<name>/)
build-*/
# CLion
cmake-build-*/
install/
dist/

# ── CMake generated ─────────────────────────────────────────────
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
_deps/
# Generated by export(TARGETS ...)
SabercatTargets.cmake

# ── Visual Studio / MSBuild ─────────────────────────────────────
.vs/
*.vcxproj.user
*.sln.docstates
Debug/
Release/
x64/

# ── Compiled binaries & objects ─────────────────────────────────
*.o
*.obj
*.lib
*.dll
*.exe
*.a
*.so
*.so.*
*.dylib
# MSVC debug/link artifacts
*.pdb
*.ilk
*.exp

# ── Compiled shaders (Slang/GLSL -> SPIR-V) ─────────────────────
*.spv

# ── Editors / tooling ───────────────────────────────────────────
.vscode/
.idea/
# clangd
.cache/
*.swp
*.swo
*~
*.user

# ── Dependency managers ─────────────────────────────────────────
vcpkg_installed/
conan/
.conan/

# ── Python (asset/AI tooling) ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# ── Docs build ──────────────────────────────────────────────────
docs/_build/
docs/.doctrees/

# ── OS files ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Temp / logs / test artifacts ────────────────────────────────
*.tmp
*.bak
*.orig
*.log
test-results/
coverage/

# ── Assets ─────────────────────────────────────────────
assets/

# Dear ImGui runtime layout state (written to the working directory on exit)
imgui.ini

# Local tool worktrees
.claude/worktrees/
